using System;

Console.Write("Quantidade de elementos: ");
int n = int.Parse(Console.ReadLine()!);
int[] v = new int[n];
for (int i = 0; i < n; i++)
{
    Console.Write($"Elemento[{i}]: ");
    v[i] = int.Parse(Console.ReadLine()!);
}
Array.Sort(v);
Array.Reverse(v);
Console.WriteLine("Vetor em ordem decrescente:");
foreach (var x in v) Console.WriteLine(x);
