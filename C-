class Program//define uma classe chamada Program
{
    static void Main()//define o método Main, que é o ponto de entrada do programa
    {
        string[] nome = new string[5];//define um array de strings chamado nome com tamanho 5
        double[] nota1 = new double[5];//define um array de doubles chamado nota1 com tamanho 5
        double[] nota2 = new double[5];//define um array de doubles chamado nota2 com tamanho 5

        for (int i = 0; i < 5; i++)//define um loop for que itera 5 vezes
        {
            Console.Write("Nome: ");//exibe a mensagem "Nome: " no console
            nome[i] = Console.ReadLine();//lê a entrada do usuário e armazena no array nome na posição i

            Console.Write("Nota 1: ");//exibe a mensagem "Nota 1: " no console
            nota1[i] = double.Parse(Console.ReadLine());//lê a entrada do usuário, converte para double e armazena no array nota1 na posição i

            Console.Write("Nota 2: ");//exibe a mensagem "Nota 2: " no console
            nota2[i] = double.Parse(Console.ReadLine());//lê a entrada do usuário, converte para double e armazena no array nota2 na posição i
        }

        Console.WriteLine("Listagem:");//exibe a mensagem "Listagem:" no console

        for (int i = 0; i < 5; i++)//define um loop for que itera 5 vezes
        {
            double media = (nota1[i] + nota2[i]) / 2;// calcula a média das notas e armazena na variável media

            Console.WriteLine($"{nome[i]} - Nota1: {nota1[i]} - Nota2: {nota2[i]} - Média: {media:F2}");//exibe o nome, nota1, nota2 e média formatada com 2 casas decimais no console
        }
    }
}
